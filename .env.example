# ==========================================================================
# Shree Chamunda Dham Aglod — Environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- Database (PostgreSQL required in production — see spec §41) -----------
# Local:     postgresql://postgres:postgres@localhost:5432/chamunda_dham?schema=public
# Neon:      postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
# Supabase:  postgresql://postgres.xxxx:pass@aws-x.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chamunda_dham?schema=public"
# Optional direct (non-pooled) URL for migrations on serverless Postgres:
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/chamunda_dham?schema=public"

# --- Auth.js (v5) ----------------------------------------------------------
# Generate with: npx auth secret   (or) openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Base URL of the deployment (used for callbacks + receipt verify links)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Private file storage (donation payment proofs — spec §17) -------------
# "local" keeps proofs in a non-public server folder served via signed admin
# routes. Swap the driver later for Cloudinary/S3 without touching call sites.
STORAGE_DRIVER="local"
# Absolute or relative path to the private (non-web-served) storage root.
PRIVATE_STORAGE_DIR="./storage/private"
# Secret used to sign temporary download URLs for admins.
STORAGE_SIGNING_SECRET="replace-with-a-long-random-secret"
# Max upload size for proofs, in megabytes.
MAX_PROOF_UPLOAD_MB="8"

# --- Cloudinary (optional — only if STORAGE_DRIVER=cloudinary) -------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Bootstrap super admin (used by `npm run create:admin`) ----------------
SEED_SUPERADMIN_EMAIL="admin@chamundadham.example"
SEED_SUPERADMIN_PASSWORD="ChangeMe!2026"
SEED_SUPERADMIN_NAME="Super Admin"

# --- Analytics (optional — spec §49) ---------------------------------------
NEXT_PUBLIC_GA_ID=""

# --- Turnstile bot protection (optional — spec §45) ------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
